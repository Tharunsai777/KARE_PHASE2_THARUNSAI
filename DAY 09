import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int a[]=new int[n];
		for(int i=0;i<n;i++){
		    a[i]=sc.nextInt();
		}
		int max=0,smax=0;
		if(a[0]>a[1]){
		    max=a[0];
		    smax=a[1];
		}else if(a[1]>a[0]){
		    max=a[1];
		    smax=a[0];
		}
		for(int i=2;i<n;i++){
		    if(a[i]>max){
		        smax=max;
		        max=a[i];
		    }else if(a[i]>smax && a[i]<max){
		        smax=a[i];
		    }
		}
		System.out.print(max+" "+smax);
	}
}
